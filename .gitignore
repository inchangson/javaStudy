# Compiled Java artifacts
*.class
*.jar
*.war
*.ear

# Build output
/out/
/build/
/target/
/bin/

# Keep source folders named out/bin if they ever exist
!**/src/main/**/out/
!**/src/test/**/out/
!**/src/main/**/bin/
!**/src/test/**/bin/

# Gradle
.gradle/

